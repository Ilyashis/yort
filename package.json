{
  "name": "citia",
  "private": true,
  "version": "0.1.0",
  "description": "AI UFA — прототип цифровой копии Уфы (three.js + OSM)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "npm run data:fetch:buildings && npm run data:fetch:environment && npm run data:fetch:terrain",
    "data:fetch:terrain": "node scripts/fetch-dem.mjs",
    "data:fetch:buildings": "node scripts/fetch-osm-buildings.mjs",
    "data:fetch:environment": "node scripts/fetch-osm-environment.mjs",
    "models:statue": "node scripts/sculpt-statue.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "geotiff": "^3.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
